      "parameters": {
        "formTitle": "Book an Appointment",
        "formDescription": "Complete the form to request an appointment. Your booking is confirmed only after the system checks availability.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Name",
              "placeholder": "Please enter your name",
              "requiredField": true
            },
            {
              "fieldLabel": "Email",
              "fieldType": "email",
              "placeholder": "example@gmail.com",
              "requiredField": true
            },
            {
              "fieldLabel": "phone number",
              "placeholder": "01xxxxxxxxx",
              "requiredField": true
            },
            {
