        "timeMin": "={{ DateTime.fromISO($json.date, { zone: 'Africa/Cairo' }).startOf('day').toUTC().toISO() }}",
        "timeMax": "={{ DateTime.fromISO($json.date, { zone: 'Africa/Cairo' }).endOf('day').toUTC().toISO() }}",
