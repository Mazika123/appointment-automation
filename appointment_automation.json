    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const booking = $('Normalize and Validate').first().json;\nconst events = $input.all();\nconst start = new Date(booking.requested_start);\nconst end = new Date(booking.requested_end);\nlet available = true;\nfor (const item of events) {\n const e = item.json || {}; if (!e.start || !e.end) continue;\n const es = new Date(e.start.dateTime || e.start.date); const ee = new Date(e.end.dateTime || e.end.date);\n if (!Number.isNaN(es.getTime()) && !Number.isNaN(ee.getTime()) && start < ee && end > es) { available = false; break; }\n}\nreturn [{ json: { ...booking, available } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
