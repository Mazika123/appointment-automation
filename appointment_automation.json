              "fieldOptions": {
                "values": [
                  {
                    "option": "Dental Checkup"
                  },
                  {
                    "option": "Dental Filling"
                  },
                  {
                    "option": "Consultation"
                  },
                  {
                    "option": "Teeth Cleaning"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Date",
              "fieldType": "date",
              "requiredField": true
            },
            {
              "fieldLabel": "time",
              "placeholder": "09:00 (24-hour format)",
              "requiredField": true
            },
            {
              "fieldLabel": "Notes",
              "fieldType": "textarea",
              "placeholder": "Optional notes"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        -800,
        0
      ],
      "id": "af6eca70-f1d0-4c47-8534-a7e5c9b229fb",
      "name": "Appointment Form",
      "webhookId": "c3b31a1c-5ad6-4fee-9575-8743983292bf"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const d = $json;\nconst name = String(d.Name ?? '').trim();\nconst email = String(d.Email ?? '').trim();\nconst rawPhone = String(d['phone number'] ?? '').trim().replace(/[\\s()-]/g, '');\nconst service = String(d.Service ?? '').trim();\nconst date = String(d.Date ?? '').trim();\nlet time = String(d.time ?? '').trim();\nconst notes = String(d.Notes ?? d['Notes:'] ?? '').trim();\nif (!name || !email || !rawPhone || !service || !date || !time) throw new Error('Name, email, phone, service, date and time are required.');\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) throw new Error('Please provide a valid email address.');\nif (/^01\\d{9}$/.test(rawPhone)) { /* Egypt mobile local format accepted */ } else if (/^\\+?201\\d{9}$/.test(rawPhone)) { /* international format accepted */ } else throw new Error('Phone must be an Egyptian mobile number, e.g. 01012345678 or +201012345678.');\nif (/^\\d{1}:\\d{2}$/.test(time)) time = '0' + time;\nif (!/^([01]\\d|2[0-3]):[0-5]\\d$/.test(time)) throw new Error('Time must use 24-hour HH:mm format, e.g. 09:30.');\nif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(date) || Number.isNaN(Date.parse(date + 'T00:00:00Z'))) throw new Error('Please provide a valid date.');\nconst phone = rawPhone.startsWith('01') ? '+20' + rawPhone.slice(1) : rawPhone.startsWith('201') ? '+' + rawPhone : rawPhone;\n// Clinic timezone is Africa/Cairo. Luxon is available in n8n Code nodes through DateTime.\nconst start = DateTime.fromISO(`${date}T${time}`, { zone: 'Africa/Cairo' });\nif (!start.isValid) throw new Error('Invalid appointment date/time.');\nif (start <= DateTime.now().setZone('Africa/Cairo')) throw new Error('Appointment must be in the future.');\nconst end = start.plus({ minutes: 60 });\nreturn { json: { name, email, phone, service, date, time, notes, requested_start: start.toUTC().toISO(), requested_end: end.toUTC().toISO(), source: 'n8n_form', appointment_id: `AP-${$execution.id}`, status: 'confirmed' } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -560,
        0
      ],
      "id": "b7816a2d-9046-4ff4-8693-c470ec761204",
      "name": "Normalize and Validate"
