    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const now = DateTime.now().setZone('Africa/Cairo');\nconst end = now.plus({ hours: 24 });\nconst out = [];\nfor (const item of $input.all()) { const r = item.json || {}; if (String(r.status || '').toLowerCase() !== 'confirmed') continue; if (String(r['24_hour_before_reminder'] || 'false').toLowerCase() === 'true') continue; const raw = r.start_time; if (!raw || !r.email) continue; const dt = DateTime.fromISO(String(raw), { setZone: true }).setZone('Africa/Cairo'); if (dt.isValid && dt > now && dt <= end) out.push({ json: { ...r, formatted_date: dt.toFormat('LLL d, yyyy'), formatted_time: dt.toFormat('hh:mm a') } }); }\nreturn out;"
      },
